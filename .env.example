# ---- Server ----
PORT=8787
# demo | live   (demo serves deterministic sample data so the dashboard works with no credentials)
DATA_MODE=demo
# Cache TTL for API responses, in minutes
CACHE_TTL_MINUTES=15

# ---- PDF export ----
# Optional: path to a Chromium/Chrome binary if Playwright's bundled browser is not installed
# CHROMIUM_PATH=/usr/bin/chromium

# ---- Google auth (service account) ----
# Either a path to the JSON key...
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# ...or the JSON itself (useful on Render / Vercel / Railway)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ---- GA4 ----
# Numeric property id (Admin -> Property settings)
GA4_PROPERTY_ID=123456789
# Key events to report as conversions (comma separated). Leave blank to use all key events found.
GA4_KEY_EVENTS=demo-submission,form_submit,form_start,file_download,click,purchase
# Path prefix that identifies blog content
BLOG_PATH_PREFIX=/blog

# ---- Google Search Console ----
# Exactly as shown in Search Console: sc-domain:performline.com  or  https://performline.com/
GSC_SITE_URL=sc-domain:performline.com

# ---- Branding ----
BRAND_NAME=PerformLine
BRAND_SITE=https://performline.com
